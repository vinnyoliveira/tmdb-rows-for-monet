    <!-- Ayuda -->
    <string name="help_title">Cómo funciona</string>
    <string name="help_step1">1. Crea una fila: filtros de TMDB, una plataforma o tu propia lista.</string>
    <string name="help_step2">2. Pulsa Guardar y publicar. La fila se convierte en un canal del dispositivo.</string>
    <string name="help_step3">3. En Monet: Personalizar → fila de medios → TMDB Rows for Monet → elige la fila por su nombre.</string>
    <string name="help_step4">4. Pulsa un póster para abrir el título en Nuvio o Stremio.</string>
    <string name="help_tip">Cada fila es un canal aparte. Si Monet muestra otro contenido, comprueba que elegiste el nombre de esa fila.</string>
    <string name="action_close">Cerrar</string>

