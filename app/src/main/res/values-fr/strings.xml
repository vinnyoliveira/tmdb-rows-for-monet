    <!-- Aide -->
    <string name="help_title">Comment ça marche</string>
    <string name="help_step1">1. Créez une rangée : filtres TMDB, une plateforme ou votre liste.</string>
    <string name="help_step2">2. Touchez Enregistrer et publier. La rangée devient un canal sur l’appareil.</string>
    <string name="help_step3">3. Dans Monet : Personnaliser → rangée de médias → TMDB Rows for Monet → choisissez la rangée par son nom.</string>
    <string name="help_step4">4. Touchez une affiche pour ouvrir le titre dans Nuvio ou Stremio.</string>
    <string name="help_tip">Chaque rangée est un canal séparé. Si Monet affiche autre chose, vérifiez que vous avez choisi le nom de cette rangée.</string>
