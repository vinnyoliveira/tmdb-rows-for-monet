    <!-- Ajuda -->
    <string name="help_title">Como funciona</string>
    <string name="help_step1">1. Crie uma linha: filtros do TMDB, uma plataforma ou a sua lista.</string>
    <string name="help_step2">2. Toque em Salvar e publicar. A linha vira um canal no aparelho.</string>
    <string name="help_step3">3. No Monet: Personalizar → linha de mídia → TMDB Rows for Monet → escolha a linha pelo nome.</string>
    <string name="help_step4">4. Toque num pôster para abrir o título no Nuvio ou no Stremio.</string>
    <string name="help_tip">Cada linha é um canal separado. Se o Monet mostrar outro conteúdo, confira se escolheu o nome dessa linha.</string>
