    <string name="setup_intro">Rows of movies and series from TMDB, on your TV launcher.</string>
    <string name="setup_key_title">First: your free TMDB key</string>
    <string name="setup_step1">1. On a phone or computer, open themoviedb.org and create a free account.</string>
    <string name="setup_step2">2. Go to Settings → API and copy the “API Key (v3 auth)”.</string>
    <string name="setup_step3">3. Paste it below, tap Validate.</string>
