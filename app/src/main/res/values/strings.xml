    <!-- Help -->
    <string name="help_title">How it works</string>
    <string name="help_step1">1. Create a row: TMDB filters, a streaming service, or your own list.</string>
    <string name="help_step2">2. Tap Save and publish. The row becomes a channel on the device.</string>
    <string name="help_step3">3. In Monet: Personalize → media row → TMDB Rows for Monet → pick the row by name.</string>
    <string name="help_step4">4. Tap a poster to open the title in Nuvio or Stremio.</string>
    <string name="help_tip">Each row is a separate channel. If Monet shows other content, check that you picked that row’s name.</string>
